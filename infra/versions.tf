# STEP 3 — Terraform core. Order inside this folder doesn't matter;
# Terraform builds the dependency graph. File split is for readability.

terraform {
  required_version = ">= 1.9"

  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "~> 5.8"
    }
    azapi = {
      source  = "Azure/azapi"
      version = "~> 2.13"
    }
  }

  # Partial config: values come from backend.hcl (generated by bootstrap).
  # Auth: Entra ID only (shared keys disabled on the state account).
  # In CI, ARM_USE_OIDC / ARM_CLIENT_ID / ARM_TENANT_ID come from the workflow.
  backend "azurerm" {}
}

# Subscription comes from ARM_SUBSCRIPTION_ID (workflow env, or export locally).
# Resource providers were registered by bootstrap; the pipeline identity is
# RG-scoped and cannot register them (v5 default = "none", stated explicitly).
provider "azurerm" {
  features {}
  resource_provider_registrations = "none"
}

provider "azapi" {}
